{
  "name": "war-room-wingman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "npm run build && node dist/src/start.js",
    "start:fast": "node dist/src/start.js",
    "test": "vitest run",
    "data:fetch": "npm run build && node dist/scripts/fetch-draft-data.js",
    "profiles:build": "npm run build && node dist/scripts/build-manager-profiles.js",
    "draft:prep": "npm run data:fetch && npm run profiles:build",
    "replay": "npm run build && node dist/scripts/replay-draft.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
